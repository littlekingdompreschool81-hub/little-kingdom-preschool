# ==========================================
# Little Kingdom Preschool - Environment Variables
# ==========================================

# 1. School Recipient Details
SCHOOL_NOTIFICATION_EMAIL=admissions@littlekingdom.example.com
WHATSAPP_NOTIFY_NUMBER=+919800000000

# 2. Email Service (Resend or SMTP)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=admissions@littlekingdom.example.com

# Or standard SMTP credentials (alternative):
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password

# 3. WhatsApp Business Cloud API (Meta Developers)
WHATSAPP_API_TOKEN=your_meta_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id

# 4. Google Maps (Optional Embed Key)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
