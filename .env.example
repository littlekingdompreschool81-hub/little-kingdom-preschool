# ==========================================
# Little Kingdom Preschool - Environment Variables Reference
# ==========================================

# 1. Staff Portal Security & Email Allowlist
# The primary site owner / principal email. Has authority to manage other staff.
ADMIN_EMAIL=principal@littlekingdom.com

# Comma-separated list of additional approved staff emails allowed to access enquiries
STAFF_ALLOWLIST=admin@littlekingdom.com,teacher@littlekingdom.com,admissions@littlekingdom.com

# Cryptographic secret for signing session tokens (generate with `openssl rand -base64 32`)
SESSION_SECRET=your-random-32-byte-secret-key-here

# 2. Google OAuth 2.0 Credentials (From Google Cloud Console)
# Authorized JavaScript origin: http://localhost:3000 (and production domain)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# 3. School Notifications
SCHOOL_NOTIFICATION_EMAIL=admissions@littlekingdom.example.com
WHATSAPP_NOTIFY_NUMBER=+919800000000

# 4. Email Service (Resend or SMTP)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=admissions@littlekingdom.example.com

# 5. WhatsApp Business Cloud API
WHATSAPP_API_TOKEN=your_meta_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_id
